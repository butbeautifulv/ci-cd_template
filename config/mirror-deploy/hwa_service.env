# Ephemeral CI deploy env for hwa_service (fixtures only — NOT production secrets).
# URL_AUTH → ci-http-stub; MONGO_* → in-namespace mongo stub.
TZ=Europe/Moscow
BASE_API_PREFIX=/v1
BACK_TO_BACK_USER=gis_admin
BACK_TO_BACK_PASSWORD=123
LOG_LEVEL=INFO
SSL_VERIFY=False
URL_AUTH=http://ci-http-stub:8000/api/v1/auth
URL_UAT=http://ci-http-stub:8000/uat
UAT_USERNAME=ci
UAT_PASSWORD=ci
USE_UAT_INTEGRATION=False
MONGO_DB_CONNECTOR=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB_NAME_HWA=hwa_db
KAFKA_TOPIC_GIS_WAYBILLS=ci-waybills
KAFKA_OFFSET_TYPE_GIS=earliest
KAFKA_BOOTSTRAP_SERVER_GIS=localhost:9092
KAFKA_GROUP_GIS_WAYBILLS=ci-hwa
COUNT_VEHICLES_SEARCH_LIMIT=1000
CLOSING_WAYBILLS_SECONDS=21600
VISIBILITY_LIMIT_AVAILABLE_WAYBILLS_SECONDS=14400
