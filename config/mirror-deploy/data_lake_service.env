# Ephemeral CI deploy env for data_lake_service (fixtures only — NOT production secrets).
# URL_* and MONGO_* point at in-namespace stubs created by deploy-test-k8s.sh
# (ci-http-stub + mongo). Postgres engines are lazy — healthcheck does not probe DB.
# Do not put GITLAB_PAT / DEFECTDOJO_* / Nexus passwords here.
BASE_API_PREFIX=/api/gis/v1/data-lake
BACK_TO_BACK_USER=gis_admin
BACK_TO_BACK_PASSWORD=123
NEED_INTERVAL=300
SCENARIO=58e5ed2a-015d-42eb-956c-2b5b46b348bc
TZ=Europe/Moscow
NEED_QUEUE_DA=DISPATCHINGAD
NEED_QUEUE_SKSANT=DISPATCHINGKSANT
URL_VARIATION=http://ci-http-stub:8000/api/v1/variation_group
URL_AUTH=http://ci-http-stub:8000/api/v1/auth
URL_HISTORY_PLAYBACK=http://ci-http-stub:8000/api/gis/v1/history-playback
S3_CONNECTOR=ci-http-stub:8000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=False
S3_BUCKET=maps
CHUNK_SIZE=1024
POSTGRES_DB_CONNECTOR_AIRCRAFT_FILTERS=postgresql+asyncpg://gis:gis@10.96.70.7:5432/aircraft_filters
POSTGRES_DB_CONNECTOR_NEEDS=postgresql+asyncpg://gis:gis@10.96.70.7:5432/needs
POSTGRES_DB_CONNECTOR_EVENTS=postgresql+asyncpg://gis:gis@10.96.70.7:5432/event_db
POSTGRES_DB_CONNECTOR_HISTORY=postgresql+asyncpg://gis:gis@10.96.70.7:5432/gis
POSTGRES_DB_CONNECTOR_DEFECTS=postgresql+asyncpg://gis:gis@10.96.70.7:5432/defects
MONGO_DB_CONNECTOR_SLC=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB_CONNECTOR_DLS=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB_CONNECTOR_ORNITHOLOGY=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB_NAME_LAYERS_DLS=layers_dls
MONGO_DB_NAME_LAYERS_SLC=layers_slc
MONGO_DB_NAME_LAYERS_ORNITHOLOGY=layers_ornitology
LOG_LEVEL=INFO
