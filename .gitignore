# Optional local vendor cache (xlsx/pdf for re-extract only; not required at runtime)
.external/*
# Local IDE / agent tooling (symlinks from cxado bootstrap — not in git)
.cursor/
.agents/
.codebase-memory/
.claude/
# Local graphify / Python noise
graphify-out/
__pycache__/
*.py[cod]
*$py.class
# Local deploy scratch (secrets live in cxado meta deploy/.secrets — never here)
/deploy/
# Mirror fleet live dumps / large ASPM HTML (keep fixtures if named *-fixture*)
reports/mirror-fleet-*.jsonl
reports/aspm-report-*.html
!reports/aspm-report-fixture*.html
.mirror-sync-state.json

